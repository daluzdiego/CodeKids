                let min = 200;
                for (let obs of obstaculos) {
                    let d = Math.sqrt((obs.x - robo.x) ** 2 + (obs.y - robo.y) ** 2) - obs.r;
                    if (d < min) min = d;
                }
                robo.sensorDist = min;
                return min;
