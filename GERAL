### Parte 4: Simulação de Rede Neural (10 minutos)

```javascript
// Simulação de um neurônio artificial
class Neuronio {
    constructor(numeroEntradas) {
        // Pesos aleatórios
        this.pesos = [];
        for (let i = 0; i < numeroEntradas; i++) {
            this.pesos.push(Math.random() * 2 - 1);
        }
        this.bias = Math.random() * 2 - 1;
    }
    
    // Função de ativação (sigmoide)
    ativacao(x) {
        return 1 / (1 + Math.exp(-x));
    }
    
    // Processar entradas
    processar(entradas) {
        let soma = this.bias;
        for (let i = 0; i < entradas.length; i++) {
            soma += entradas[i] * this.pesos[i];
        }
        return this.ativacao(soma);
    }
    
    // Ajustar pesos
    ajustar(taxa, erro, entradas) {
        for (let i = 0; i < this.pesos.length; i++) {
            this.pesos[i] += taxa * erro * entradas[i];
        }
        this.bias += taxa * erro;
    }
}

