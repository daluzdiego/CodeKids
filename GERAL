                    ctx.fillStyle = "#e74c3c";
                    ctx.shadowColor = "#e74c3c";
                    ctx.shadowBlur = 10;
                    ctx.beginPath();
                    ctx.arc(obs.x, obs.y, obs.r, 0, Math.PI * 2);
