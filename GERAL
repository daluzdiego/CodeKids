// Robô Inteligente Simulado
class Robo {
    constructor(nome, x, y) {
        this.nome = nome;
        this.x = x;
        this.y = y;
        this.direcao = 0;
        this.velocidade = 2;
        this.sensores = { distancia: 100, cor: "branco" };
        this.estado = "explorando";
        this.obstaculos = [];
        this.mapa = [];
    }
    
    // Sensor de distância
    lerSensorDistancia() {
        let distancia = 100;
        for (let obs of this.obstaculos) {
            let d = Math.sqrt((obs.x - this.x) ** 2 + (obs.y - this.y) ** 2);
            if (d < distancia) distancia = d;
        }
        this.sensores.distancia = distancia;
        return distancia;
    }
    
    // Tomar decisão
    decidir() {
        this.lerSensorDistancia();
        
        if (this.sensores.distancia < 30) {
            this.estado = "desviando";
        } else if (this.sensores.distancia < 60) {
            this.estado = "atento";
        } else {
            this.estado = "explorando";
        }
    }
    
    // Agir
    agir() {
        switch(this.estado) {
            case "desviando":
                this.direcao += 45;
                this.mover();
                break;
            case "atento":
                this.velocidade = 1;
                this.mover();
                break;
            case "explorando":
                this.velocidade = 2;
                this.mover();
                break;
        }
    }
    
    mover() {
        let rad = this.direcao * Math.PI / 180;
        this.x += Math.cos(rad) * this.velocidade;
        this.y += Math.sin(rad) * this.velocidade;
        
        // Limites do mapa
        if (this.x < 0 || this.x > 400) this.direcao = 180 - this.direcao;
        if (this.y < 0 || this.y > 300) this.direcao = -this.direcao;
    }
    
    // Ciclo completo
    atualizar() {
        this.decidir();
        this.agir();
        console.log(`🤖 ${this.nome} | Estado: ${this.estado} | Pos: (${this.x.toFixed(0)}, ${this.y.toFixed(0)}) | Dist: ${this.sensores.distancia.toFixed(0)}`);
    }
}

