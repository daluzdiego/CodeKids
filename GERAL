// URL do modelo (substituir pelo seu modelo do Teachable Machine)
const URL = "./modelo/";

let model, webcam, labelContainer, maxPredictions;
let ativo = false;

async function init() {
    if (ativo) return;
    
    try {
        const modelURL = URL + "model.json";
        const metadataURL = URL + "metadata.json";
        
        // Carregar modelo
        model = await tmImage.load(modelURL, metadataURL);
        maxPredictions = model.getTotalClasses();
        
        // Configurar webcam
        const flip = true;
        webcam = new tmImage.Webcam(300, 300, flip);
        await webcam.setup();
        await webcam.play();
        ativo = true;
        
        // Adicionar ao DOM
        document.getElementById("webcam-container").innerHTML = "";
        document.getElementById("webcam-container").appendChild(webcam.canvas);
        
        labelContainer = document.getElementById("label-container");
        labelContainer.innerHTML = "";
        
        for (let i = 0; i < maxPredictions; i++) {
            let div = document.createElement("div");
            div.className = "predicao";
            labelContainer.appendChild(div);
        }
        
        window.requestAnimationFrame(loop);
        console.log("Modelo carregado!");
    } catch (e) {
        console.error("Erro ao carregar modelo:", e);
        document.getElementById("label-container").innerHTML = 
            "<p style='color:red'>❌ Erro ao carregar o modelo. Verifique se o modelo está na pasta 'modelo'.</p>";
    }
}

async function loop() {
    if (!ativo) return;
    webcam.update();
    await predict();
    window.requestAnimationFrame(loop);
}

async function predict() {
    const prediction = await model.predict(webcam.canvas);
    
    for (let i = 0; i < maxPredictions; i++) {
        const classPrediction = prediction[i].className + ": " + (prediction[i].probability * 100).toFixed(0) + "%";
        const div = labelContainer.childNodes[i];
        div.textContent = classPrediction;
        div.style.background = `linear-gradient(90deg, #3498db ${prediction[i].probability * 100}%, #ecf0f1 ${prediction[i].probability * 100}%)`;
    }
}

function parar() {
    ativo = false;
    if (webcam) {
        webcam.stop();
    }
    console.log("Câmera parada");
}

