            let temperaturaAtual = 25;
            
            function mostrarBarra(temperatura) {
                // Limpar LEDs
                for (let i = 0; i < 25; i++) {
                    document.getElementById(`led-${i}`).className = "";
                }
                
                // Calcular nível (0-5)
                let nivel = Math.max(0, Math.min(5, Math.round((temperatura + 10) / 12)));
                
                // Acender barra
                for (let y = 0; y < nivel; y++) {
                    document.getElementById(`led-${y * 5 + 4}`).className = "on";
                }
            }
            
            function atualizar() {
                document.getElementById("temperatura").textContent = temperaturaAtual + "°C";
                
                // Atualizar indicador
                let porcentagem = (temperaturaAtual + 10) / 60 * 100;
                porcentagem = Math.max(0, Math.min(100, porcentagem));
                document.getElementById("indicador").style.left = porcentagem + "%";
                
                mostrarBarra(temperaturaAtual);
                
                let info = "";
                if (temperaturaAtual < 10) info = "❄️ Muito frio!";
                else if (temperaturaAtual < 20) info = "🌤️ Frio";
                else if (temperaturaAtual < 30) info = "😊 Agradável";
                else if (temperaturaAtual < 40) info = "🔥 Quente";
                else info = "🌡️ Muito quente!";
                
                document.getElementById("info").textContent = info;
                console.log(`Temperatura: ${temperaturaAtual}°C`);
            }
            
            function simularFrio() {
                temperaturaAtual = Math.round(Math.random() * 20 - 10);
                atualizar();
            }
            
            function simularQuente() {
                temperaturaAtual = Math.round(Math.random() * 30 + 25);
                atualizar();
            }
            
            atualizar();
            console.log("Termômetro carregado!");
        </script>
