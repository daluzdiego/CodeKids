function analisarSentimento(texto) {
    let positivas = ["bom", "ótimo", "excelente", "feliz", "amor", "gostei", "maravilhoso"];
    let negativas = ["ruim", "péssimo", "triste", "ódio", "não gostei", "horrível"];
    
    let palavras = texto.toLowerCase().split(" ");
    let pontuacao = 0;
    
    for (let palavra of palavras) {
        if (positivas.includes(palavra)) pontuacao++;
        if (negativas.includes(palavra)) pontuacao--;
    }
    
    if (pontuacao > 0) return "😊 Positivo";
    if (pontuacao < 0) return "😢 Negativo";
    return "😐 Neutro";
}

