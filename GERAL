            let direcaoAtual = 0;
            
            function getDirecao(graus) {
                if (graus < 45 || graus >= 315) return "Norte";
                if (graus < 135) return "Leste";
                if (graus < 225) return "Sul";
                return "Oeste";
            }
            
            function atualizar(graus) {
                direcaoAtual = graus;
                let direcao = getDirecao(graus);
                
                document.getElementById("agulha").style.transform = 
