            function mostrarSorriso() {
                mostrar(sorriso);
                document.getElementById("info").textContent = "😊 Sorriso";
                console.log("Sorriso exibido");
            }
            
            let animando = false;
            let intervalo = null;
            
            function animar() {
                if (animando) return;
                animando = true;
                let alternar = true;
                intervalo = setInterval(() => {
                    mostrar(alternar ? coracao : sorriso);
                    alternar = !alternar;
                }, 500);
                document.getElementById("info").textContent = "✨ Animando...";
                console.log("Animação iniciada");
            }
            
            function limpar() {
                animando = false;
                if (intervalo) clearInterval(intervalo);
                mostrar(new Array(25).fill(0));
                document.getElementById("info").textContent = "Limpo";
                console.log("Limpo");
            }
            
            console.log("Micro:bit simulado carregado!");
        </script>
