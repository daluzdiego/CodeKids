// Código de Ética em IA
class CodigoEticaIA {
    constructor() {
        this.principios = [
            "🤝 Justiça: Tratar todos com igualdade",
            "🔍 Transparência: Explicar decisões",
            "🔒 Privacidade: Proteger dados",
            "⚖️ Responsabilidade: Assumir consequências",
            "🌍 Benefício: Ajudar a sociedade"
        ];
    }
    
    verificar(acao) {
        let violacoes = [];
        
        if (acao.discrimina) {
            violacoes.push("❌ Discriminação detectada!");
        }
        if (acao.invadePrivacidade) {
            violacoes.push("❌ Violação de privacidade!");
        }
        if (!acao.transparente) {
            violacoes.push("❌ Falta de transparência!");
        }
        
        return violacoes.length === 0 ? "✅ Ação ética!" : violacoes.join("\n");
    }
    
    mostrarPrincipios() {
        console.log("📜 CÓDIGO DE ÉTICA EM IA");
        console.log("=".repeat(30));
        this.principios.forEach(p => console.log(p));
    }
}

