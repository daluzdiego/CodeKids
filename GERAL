        </style>
    </head>
    <body>
        <div class="container">
            <h1>🎵 Piano Micro:bit</h1>
            
            <div class="nota-tocada" id="notaTocada">-</div>
            
            <div class="teclado">
                <button class="tecla" onclick="tocarNota('Dó', 262)">Dó</button>
                <button class="tecla" onclick="tocarNota('Ré', 294)">Ré</button>
                <button class="tecla" onclick="tocarNota('Mi', 330)">Mi</button>
                <button class="tecla" onclick="tocarNota('Fá', 349)">Fá</button>
                <button class="tecla" onclick="tocarNota('Sol', 392)">Sol</button>
                <button class="tecla" onclick="tocarNota('Lá', 440)">Lá</button>
                <button class="tecla" onclick="tocarNota('Si', 494)">Si</button>
                <button class="tecla" onclick="tocarNota('Dó+', 523)">Dó+</button>
            </div>
            
            <button class="btn" onclick="tocarMusica()">🎵 Tocar Música</button>
            <button class="btn" onclick="parar()">⏹️ Parar</button>
            
            <div class="info" id="info">Clique nas teclas para tocar notas</div>
        </div>
        
        <script>
            let audioContext = null;
            
            function getAudioContext() {
                if (!audioContext) {
                    audioContext = new (window.AudioContext || window.webkitAudioContext)();
                }
                return audioContext;
            }
            
            function tocarNota(nome, frequencia) {
                try {
                    let ctx = getAudioContext();
                    let osc = ctx.createOscillator();
                    let gain = ctx.createGain();
                    
                    osc.type = "sine";
                    osc.frequency.value = frequencia;
                    
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);
                    
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    
                    osc.start();
                    osc.stop(ctx.currentTime + 0.5);
                    
                    document.getElementById("notaTocada").textContent = `🎵 ${nome}`;
                    document.getElementById("info").textContent = `Tocando: ${nome} (${frequencia} Hz)`;
                    console.log(`Nota: ${nome} - ${frequencia} Hz`);
                } catch (e) {
                    console.error("Erro ao tocar som:", e);
                }
            }
            
            function tocarMusica() {
                let notas = [
                    { nome: "Dó", freq: 262, dur: 400 },
                    { nome: "Dó", freq: 262, dur: 400 },
                    { nome: "Sol", freq: 392, dur: 400 },
                    { nome: "Sol", freq: 392, dur: 400 },
                    { nome: "Lá", freq: 440, dur: 400 },
                    { nome: "Lá", freq: 440, dur: 400 },
                    { nome: "Sol", freq: 392, dur: 800 },
                    { nome: "Fá", freq: 349, dur: 400 },
                    { nome: "Fá", freq: 349, dur: 400 },
                    { nome: "Mi", freq: 330, dur: 400 },
                    { nome: "Mi", freq: 330, dur: 400 },
                    { nome: "Ré", freq: 294, dur: 400 },
                    { nome: "Ré", freq: 294, dur: 400 },
                    { nome: "Dó", freq: 262, dur: 800 }
                ];
                
                let tempo = 0;
                let timeouts = [];
                
                for (let n of notas) {
                    let t = setTimeout(() => {
                        tocarNota(n.nome, n.freq);
                    }, tempo);
                    timeouts.push(t);
                    tempo += n.dur;
                }
                
                document.getElementById("info").textContent = "🎵 Tocando Brilha Brilha Estrelinha...";
            }
            
            function parar() {
                if (audioContext) {
                    audioContext.close();
                    audioContext = null;
                }
                document.getElementById("notaTocada").textContent = "-";
                document.getElementById("info").textContent = "⏹️ Parado";
                console.log("Som parado");
            }
            
            console.log("Piano carregado!");
        </script>
