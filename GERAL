                document.getElementById("graus").textContent = graus + "°";
                
                console.log(`Direção: ${direcao} (${graus}°)`);
            }
            
            function calibrar() {
                document.getElementById("info").textContent = "🧭 Calibrando...";
                let i = 0;
                let intervalo = setInterval(() => {
                    atualizar((direcaoAtual + 45) % 360);
                    i++;
                    if (i > 7) {
                        clearInterval(intervalo);
                        document.getElementById("info").textContent = "✅ Calibrado!";
                        console.log("Bússola calibrada");
                    }
                }, 200);
            }
            
            function girar() {
                let novoGrau = Math.floor(Math.random() * 360);
                atualizar(novoGrau);
                document.getElementById("info").textContent = `Direção: ${getDirecao(novoGrau)}`;
