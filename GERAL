```javascript
// NPC Inteligente
class NPC {
    constructor(nome, x, y) {
        this.nome = nome;
        this.x = x;
        this.y = y;
        this.estado = "idle";
        this.velocidade = 1;
        this.vida = 100;
        this.alvo = null;
    }
    
    // Atualizar comportamento
    atualizar(jogador) {
        let distancia = this.calcularDistancia(jogador);
        
        if (distancia < 100) {
            this.estado = "perseguindo";
        } else if (distancia < 200) {
            this.estado = "patrulhando";
        } else {
            this.estado = "idle";
        }
        
        switch(this.estado) {
            case "perseguindo":
                this.perseguir(jogador);
                break;
            case "patrulhando":
                this.patrulhar();
                break;
            case "idle":
                // Não faz nada
                break;
        }
    }
    
    calcularDistancia(jogador) {
        let dx = jogador.x - this.x;
        let dy = jogador.y - this.y;
        return Math.sqrt(dx * dx + dy * dy);
    }
    
    perseguir(jogador) {
        let dx = jogador.x - this.x;
        let dy = jogador.y - this.y;
        let distancia = Math.sqrt(dx * dx + dy * dy);
        
        if (distancia > 0) {
            this.x += (dx / distancia) * this.velocidade;
            this.y += (dy / distancia) * this.velocidade;
        }
    }
    
    patrulhar() {
        // Movimento aleatório
        this.x += (Math.random() - 0.5) * this.velocidade * 2;
        this.y += (Math.random() - 0.5) * this.velocidade * 2;
    }
    
    receberDano(dano) {
        this.vida -= dano;
        if (this.vida <= 0) {
            console.log(`${this.nome} foi derrotado!`);
            return true;
        }
        console.log(`${this.nome} recebeu ${dano} de dano! Vida: ${this.vida}`);
        return false;
    }
}

