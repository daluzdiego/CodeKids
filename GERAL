            <div class="temperatura" id="temperatura">--°C</div>
            
            <div class="escala">
                <div class="indicador" id="indicador" style="left: 50%;"></div>
            </div>
            
            <div class="info">-10°C a 50°C</div>
            
            <button class="btn" onclick="atualizar()">🔄 Atualizar</button>
            <button class="btn" onclick="simularFrio()">❄️ Frio</button>
            <button class="btn" onclick="simularQuente()">🔥 Quente</button>
            
