                ctx.shadowColor = "#2ecc71";
                ctx.shadowBlur = 15;
                ctx.beginPath();
                ctx.arc(jogador.x, jogador.y, jogador.tamanho, 0, Math.PI * 2);
                ctx.fill();
                
                // Inimigo
                ctx.fillStyle = "#e74c3c";
                ctx.shadowColor = "#e74c3c";
                ctx.beginPath();
                ctx.arc(inimigo.x, inimigo.y, inimigo.tamanho, 0, Math.PI * 2);
                ctx.fill();
                
                ctx.shadowBlur = 0;
            }
            
            function loop() {
                if (!jogoAtivo) return;
                moverJogador();
                moverInimigo();
                verificarColisao();
                desenhar();
                loopId = requestAnimationFrame(loop);
            }
            
            function iniciar() {
                if (jogoAtivo) return;
                jogador = { x: 50, y: 150, tamanho: 15, vida: 100 };
                inimigo = { x: 300, y: 150, tamanho: 15, vida: 100, velocidade: 1.5 };
                document.getElementById("vidaJogador").textContent = 100;
                document.getElementById("vidaInimigo").textContent = 100;
                jogoAtivo = true;
                loop();
                console.log("Jogo iniciado");
            }
            
            function parar() {
                jogoAtivo = false;
                if (loopId) {
                    cancelAnimationFrame(loopId);
                    loopId = null;
                }
                console.log("Jogo parado");
            }
            
            desenhar();
            console.log("Jogo com IA carregado!");
