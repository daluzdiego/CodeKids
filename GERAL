<!DOCTYPE html>
<html>
    <head>
        <title>Som Micro:bit</title>
        <style>
            body { font-family: Arial; padding: 20px; background: #1a1a2e; color: white; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
            .container { background: #16213e; padding: 30px; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); text-align: center; max-width: 500px; }
            h1 { color: #9b59b6; }
            .teclado { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 20px 0; }
            .tecla { padding: 20px 10px; background: #9b59b6; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: bold; font-size: 16px; transition: 0.2s; }
            .tecla:hover { background: #8e44ad; transform: scale(1.05); }
            .tecla:active { transform: scale(0.95); background: #7d3c98; }
