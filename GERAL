```html
<!DOCTYPE html>
<html>
    <head>
        <title>Programando LEDs</title>
        <style>
            body { font-family: Arial; padding: 20px; background: #1a1a2e; color: white; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
            .container { background: #16213e; padding: 30px; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); text-align: center; max-width: 500px; }
            h1 { color: #2ecc71; }
            .led { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; max-width: 150px; margin: 20px auto; }
            .led div { width: 25px; height: 25px; background: #0f3460; border-radius: 5px; transition: 0.1s; }
            .led div.on { background: #e74c3c; box-shadow: 0 0 15px #e74c3c; }
            .botoes { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin: 15px 0; }
            .btn { padding: 8px 16px; background: #3498db; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 14px; }
            .btn:hover { background: #2980b9; }
            .btn-limpar { background: #e74c3c; }
            .btn-limpar:hover { background: #c0392b; }
            .info { color: #7f8c8d; font-size: 14px; margin-top: 15px; }
            .contador { color: #f1c40f; font-weight: bold; }
        </style>
    </head>
    <body>
        <div class="container">
            <h1>💡 Programando LEDs</h1>
            
            <div class="led" id="led"></div>
            
            <div class="botoes">
                <button class="btn" onclick="acenderTodos()">💡 Acender Todos</button>
                <button class="btn" onclick="apagarTodos()">🌑 Apagar Todos</button>
                <button class="btn" onclick="animarLinhas()">➡️ Linhas</button>
                <button class="btn" onclick="animarColunas()">⬇️ Colunas</button>
                <button class="btn" onclick="animarDiagonal()">↘️ Diagonal</button>
                <button class="btn btn-limpar" onclick="parar()">⏹️ Parar</button>
            </div>
            
            <div class="info">Cliques: <span class="contador" id="contador">0</span></div>
            <div class="info" id="info">Escolha uma animação</div>
        </div>
        
        <script>
            let ledDiv = document.getElementById("led");
            let animando = false;
            let intervalo = null;
            let cliques = 0;
            
            for (let i = 0; i < 25; i++) {
                ledDiv.innerHTML += `<div id="led-${i}"></div>`;
            }
            
            function getLED(x, y) {
                return document.getElementById(`led-${y * 5 + x}`);
            }
            
            function ligar(x, y) {
                getLED(x, y).className = "on";
            }
            
            function desligar(x, y) {
                getLED(x, y).className = "";
            }
            
            function limpar() {
                for (let i = 0; i < 25; i++) {
                    document.getElementById(`led-${i}`).className = "";
                }
            }
            
            function pararAnimacao() {
                animando = false;
                if (intervalo) {
                    clearInterval(intervalo);
                    intervalo = null;
                }
            }
            
            function acenderTodos() {
                pararAnimacao();
                for (let i = 0; i < 25; i++) {
                    document.getElementById(`led-${i}`).className = "on";
                }
                document.getElementById("info").textContent = "💡 Todos acesos";
                cliques++;
                document.getElementById("contador").textContent = cliques;
                console.log("Todos acesos");
            }
            
            function apagarTodos() {
                pararAnimacao();
                limpar();
                document.getElementById("info").textContent = "🌑 Todos apagados";
                cliques++;
                document.getElementById("contador").textContent = cliques;
                console.log("Todos apagados");
            }
            
            function animarLinhas() {
                pararAnimacao();
                limpar();
                animando = true;
                let linha = 0;
                intervalo = setInterval(() => {
                    limpar();
                    for (let x = 0; x < 5; x++) {
                        ligar(x, linha);
                    }
                    linha = (linha + 1) % 5;
                }, 200);
                document.getElementById("info").textContent = "➡️ Animando linhas...";
                cliques++;
                document.getElementById("contador").textContent = cliques;
                console.log("Animar linhas");
            }
            
            function animarColunas() {
                pararAnimacao();
                limpar();
                animando = true;
                let coluna = 0;
                intervalo = setInterval(() => {
                    limpar();
                    for (let y = 0; y < 5; y++) {
                        ligar(coluna, y);
                    }
                    coluna = (coluna + 1) % 5;
                }, 200);
                document.getElementById("info").textContent = "⬇️ Animando colunas...";
                cliques++;
                document.getElementById("contador").textContent = cliques;
                console.log("Animar colunas");
            }
            
            function animarDiagonal() {
                pararAnimacao();
                limpar();
                animando = true;
                let pos = 0;
                intervalo = setInterval(() => {
                    limpar();
                    for (let i = 0; i <= pos && i < 5; i++) {
                        ligar(i, i);
                    }
                    pos++;
                    if (pos > 5) pos = 0;
                }, 300);
                document.getElementById("info").textContent = "↘️ Animando diagonal...";
                cliques++;
                document.getElementById("contador").textContent = cliques;
                console.log("Animar diagonal");
            }
            
            function parar() {
                pararAnimacao();
                limpar();
                document.getElementById("info").textContent = "⏹️ Parado";
                console.log("Parado");
            }
            
            console.log("Programador de LEDs carregado!");
        </script>
    </body>
