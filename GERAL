    <body>
        <div class="container">
            <h1>💡 Micro:bit LEDs</h1>
            <div class="led" id="led"></div>
            <div class="botoes">
                <button class="btn" onclick="mostrarCoracao()">❤️ Coração</button>
                <button class="btn" onclick="mostrarSorriso()">😊 Sorriso</button>
                <button class="btn" onclick="animar()">✨ Animar</button>
                <button class="btn" onclick="limpar()">🗑️ Limpar</button>
