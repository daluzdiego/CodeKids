        <script>
            const canvas = document.getElementById("jogo");
            const ctx = canvas.getContext("2d");
            
            let jogador = { x: 50, y: 150, tamanho: 15, vida: 100 };
            let inimigo = { x: 300, y: 150, tamanho: 15, vida: 100, velocidade: 1.5 };
            let teclas = {};
            let jogoAtivo = false;
            let loopId = null;
            
            document.addEventListener("keydown", (e) => {
                teclas[e.key] = true;
                if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(e.key)) {
                    e.preventDefault();
                }
            });
            
            document.addEventListener("keyup", (e) => {
                teclas[e.key] = false;
            });
            
            function moverJogador() {
                let vel = 3;
                if (teclas["ArrowUp"] && jogador.y > jogador.tamanho) jogador.y -= vel;
                if (teclas["ArrowDown"] && jogador.y < canvas.height - jogador.tamanho) jogador.y += vel;
                if (teclas["ArrowLeft"] && jogador.x > jogador.tamanho) jogador.x -= vel;
                if (teclas["ArrowRight"] && jogador.x < canvas.width - jogador.tamanho) jogador.x += vel;
            }
            
            function moverInimigo() {
                let dx = jogador.x - inimigo.x;
                let dy = jogador.y - inimigo.y;
                let distancia = Math.sqrt(dx * dx + dy * dy);
                
                if (distancia > 0) {
                    inimigo.x += (dx / distancia) * inimigo.velocidade;
                    inimigo.y += (dy / distancia) * inimigo.velocidade;
